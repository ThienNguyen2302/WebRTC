generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  WAITING
  ACTIVE
  CLOSED
  EXPIRED
}

model Room {
  id               String     @id @default(uuid()) @db.Uuid
  inviteSecretHash String     @unique
  status           RoomStatus @default(WAITING)
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  closedAt         DateTime?
}
